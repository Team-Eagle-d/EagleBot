{
  "imports": {
    "@discordeno/bot": "npm:@discordeno/bot@^21.0.0",
    "@std/path": "jsr:@std/path@^1.1.6"
  },
  "tasks": {
    "start": "deno run -R -N -E --env-file=./.env ./src/index.ts",
    "start:test": "deno run -R -N -E --env-file=./.env.test ./src/index.ts",
    "start:test-dev": "deno run -R -N -E --env-file=./.env.test --watch=**/*.ts ./src/index.ts"
  }
}