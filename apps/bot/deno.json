{
  "imports": {
    "@discordeno/bot": "npm:@discordeno/bot@^21.0.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "drizzle-kit": "npm:drizzle-kit@^0.31.10",
    "drizzle-orm": "npm:drizzle-orm@^0.45.2"
  },
  "tasks": {
    "start": "deno run -R -N -E --env-file=./.env.production ./src/index.ts",
    "start:dev": "deno run -R -N -E --env-file=./.env.development ./src/index.ts",
    "start:dev-watch": "deno run -R -N -E --env-file=./.env.development --watch=**/*.ts ./src/index.ts"
  }
}