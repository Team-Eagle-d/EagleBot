{
    "workspace": {
        "members": [
            "./apps/bot",
            "./packages/types",
            "./packages/constants",
            "./packages/utils",
            "./packages/database"
        ]
    },
    "compilerOptions": {
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "lib": [
            "deno.ns"
        ]
    },
    "tasks": {
        "start:dev": "deno task --cwd apps/bot start:dev",
        "start:dev-watch": "deno task --cwd apps/bot start:dev-watch",

        "db:make": "deno task --env-file=./.env.migration.production --cwd packages/database make",
        "db:migrate": "deno task --env-file=./.env.migration.production --cwd packages/database migrate",
        "db:rollback": "deno task --env-file=./.env.migration.production --cwd packages/database rollback",
        "db:status": "deno task --env-file=./.env.migration.production --cwd packages/database status",

        "db:migrate-dev": "deno task --env-file=./.env.migration.development --cwd packages/database migrate",
        "db:rollback-dev": "deno task --env-file=./.env.migration.production --cwd packages/database rollback",
        "db:status-dev": "deno task --env-file=./.env.migration.production --cwd packages/database status"
    }
}