{
    "workspace": {
        "members": [
            "./apps/bot",
            "./packages/types",
            "./packages/constants",
            "./packages/utils",
            "./packages/database"
        ]
    },
    "compilerOptions": {
        "erasableSyntaxOnly": true,
        "strict": true,
        "lib": [
            "deno.ns"
        ]
    },
    "tasks": {
        "start:dev": "deno task --cwd apps/bot start:dev",

        "db:generate": "deno task --cwd packages/database generate",
        "db:migrate": "deno task --cwd packages/database migrate",
        "db:push": "deno task --cwd packages/database push"
    }
}