{
    "workspace": {
        "members": [
            "./apps/bot",
            "./packages/types",
            "./packages/constants",
            "./packages/utils",
            "./packages/database"
        ]
    },
    "compilerOptions": {
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "lib": [
            "deno.ns"
        ]
    },
    "tasks": {
        "start:dev": "deno task --cwd apps/bot start:dev",
        "start:dev-watch": "deno task --cwd apps/bot start:dev-watch",

        "db:make": "deno task --cwd packages/database make",
        "db:migrate": "deno task --cwd packages/database migrate",
        "db:up": "deno task --cwd packages/database up",
        "db:rollback": "deno task --cwd packages/database rollback",
        "db:down": "deno task --cwd packages/database down",
        "db:list": "deno task --cwd packages/database list",

        "db:migrate-dev": "deno task --env-file=./.env.migration.development --cwd packages/database migrate",
        "db:up-dev": "deno task --env-file=./.env.migration.development --cwd packages/database up",
        "db:rollback-dev": "deno task --env-file=./.env.migration.development --cwd packages/database rollback",
        "db:down-dev": "deno task --env-file=./.env.migration.development --cwd packages/database down",
        "db:list-dev": "deno task --env-file=./.env.migration.development --cwd packages/database list"
    }
}