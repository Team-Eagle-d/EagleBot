{
    "workspace": {
        "members": [
            "./apps/bot",
            "./packages/types",
            "./packages/constants",
            "./packages/utils",
            "./packages/database"
        ]
    },
    "compilerOptions": {
        "erasableSyntaxOnly": true,
        "strict": true,
        "lib": [
            "deno.ns"
        ]
    },
    "tasks": {
        "start:test": "deno task --cwd apps/bot start:test",
        "start:test-dev": "deno task --cwd apps/bot start:test-dev",

        "db:generate": "deno task --env-file=./.env.migration --cwd packages/database generate --name develop",
        "db:migrate": "deno task --env-file=./.env.migration --cwd packages/database migrate",

        "db:migrate-test": "deno task --env-file=./.env.migration.test --cwd packages/database migrate",
        "db:push-test": "deno task --env-file=./.env.migration.test --cwd packages/database push"
    }
}