{
    "name": "@eaglebot/database",
    "version": "0.1.0",
    "exports": {
        ".": "./src/index.ts"
    },
    "imports": {
        "kysely": "npm:kysely@^0.29.5",
        "kysely-ctl": "npm:kysely-ctl@^0.21.0",
        "kysely-postgres-js": "npm:kysely-postgres-js@^4.0.0",
        "postgres": "npm:postgres@^3.4.9"
    },
    "tasks": {
        "make": "deno run -A npm:kysely-ctl migrate:make --config=./kysely.config.ts",
        "migrate": "deno run -A npm:kysely-ctl migrate:latest --config=./kysely.config.ts",
        "rollback": "deno run -A npm:kysely-ctl migrate:rollback --config=./kysely.config.ts",
        "status": "deno run -A npm:kysely-ctl migrate:status --config=./kysely.config.ts"
    },
    "compilerOptions": {
        "lib": [
            "deno.window"
        ]
    }
}