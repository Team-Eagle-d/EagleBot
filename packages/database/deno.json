{
    "name": "@eaglebot/database",
    "version": "0.1.0",
    "exports": {
        ".": "./src/index.ts"
    },
    "imports": {
        "@std/path": "jsr:@std/path@^1.1.6",
        "drizzle-kit": "npm:drizzle-kit@^0.31.10",
        "drizzle-orm": "npm:drizzle-orm@^0.45.2",
        "postgres": "npm:postgres@^3.4.9"
    },
    "tasks": {
        "generate": "deno run -A npm:drizzle-kit generate",
        "migrate": "deno run -A npm:drizzle-kit migrate",
        "push": "deno run -A npm:drizzle-kit push"
    }
}